      \u043E\u043D \u0441\u0443\u043C\u0435\u043B \u0434\u043E\u0439\u0442\u0438
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430, \u043D\u043E \u043D\u0435 \u0443\u0441\u043F\u0435\u043B
      \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u0442\u044C \u044F\u0434\u0440\u043E.
      \u0412\u0430\u0448\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
      \u044D\u0442\u043E \u0434\u0435\u043B\u043E \u0437\u0430 \u043D\u0435\u0433\u043E.
      \u0423\u0434\u0430\u0447\u0438."
