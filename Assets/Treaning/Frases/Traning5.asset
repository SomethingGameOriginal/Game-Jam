  _sentence:
    CharacterName: "\u0420\u0430\u0446\u0438\u044F"
    Text: "\u041D\u0430 \u044D\u0442\u043E\u043C, \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
      \u043E\u043A\u043E\u043D\u0447\u0435\u043D\u043E. \u0412\u044B \u0433\u043E\u0442\u043E\u0432\u044B
      \u0440\u0430\u0437 \u0437\u0430 \u0440\u0430\u0437\u043E\u043C \u0448\u0442\u0443\u0440\u043C\u0430\u0442\u044C
      \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435
      \u0432 \u043F\u043E\u043F\u044B\u0442\u043A\u0430\u0445 \u0432\u0437\u043E\u0440\u0432\u0430\u0442\u044C
      \u044F\u0434\u0440\u043E, \u0435\u0433\u043E \u0431\u0443\u0434\u0435\u0442
      \u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u0441\u0430\u043C\u044B\u0439
      \u0441\u043B\u043E\u0436\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
      - \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0438\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0441 \u0437\u0430\u0434\u0430\u0447\u0435\u0439."
