  _sentence:
    CharacterName: "\u0420\u0430\u0446\u0438\u044F"
    Text: "\u0414\u0430, \u044D\u0442\u043E \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u0438\u043A
