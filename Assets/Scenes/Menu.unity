  m_Script: {fileID: 11500000, guid: 12a50bb6f12a8d841990200a7e5c1a92, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RandomFrazes
  targetText: {fileID: 192037746}
  targetText1: {fileID: 62777426}
  targetText2: {fileID: 1701505287}
  quotes:
  - "\u0410\u0440\u0431\u0443\u0437 \u043D\u0435 \u043E\u0432\u043E\u0449 - \u043B\u0435\u0434\u0438\u0431\u0430\u0433
    \u0441\u043F\u0435\u0448\u0438\u0442 \u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C"
  - "\u0417\u043D\u0430\u043D\u0438\u0435 \u2014 \u0441\u0438\u043B\u0430."
  - "\u0421\u043B\u043E\u0436\u043D\u043E \u0432 \u0443\u0447\u0435\u043D\u0438\u0438
    \u2014 \u043B\u0435\u0433\u043A\u043E \u0432 \u0431\u043E\u044E."
  - "\u041F\u043E\u043C\u043D\u0438\u0448\u044C \u041B\u0451\u0445\u0443?"
  - "\u0414\u043E\u0439\u0434\u0438 \u0434\u043E \u043A\u043E\u043D\u0446\u0430!
    (\u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430)"
  - "\u0412 \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u0435 \u0435\u0441\u0442\u044C
    \u043E\u0442\u0441\u044B\u043B\u043A\u0438!"
  - "\u041F\u0440\u043E\u0431\u044B\u0432\u0430\u043B \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432?"
  - "\u0422\u0438\u0442\u0440\u044B \u0437\u0430\u0448\u0438\u0431\u0438\u0441\u044C!"
  replaceAllText: 1
  insertIndex: 0
